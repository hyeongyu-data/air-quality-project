# 운영 프로필(docker-compose.prod.yaml)의 consumer env_file 전용.
# 비밀 아닌 설정만 둔다 — 시크릿은 ./secrets/ 파일로 (secrets/README.md).
#
#   cp .env.prod.example .env.prod   후 값 조정
#
# 오버레이가 기본 compose의 `env_file: - .env`를 이 파일로 통째 교체한다.
# 그래서 운영 호스트에 시크릿 담긴 dev .env가 남아 있어도 컨테이너에 주입되지 않는다.

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX_PREFIX=weather-alert

# Consumer 상태 파일 (명명 볼륨 /app/state)
KAKAO_TOKEN_STATE_PATH=/app/state/kakao_token.json
SIGNATURE_STATE_PATH=/app/state/signature_state.json

# 알림 채널 (쓰는 것만 true)
EMAIL_ENABLED=false
KAKAO_ENABLED=false
SLACK_ENABLED=false

# 이메일 — 비밀번호는 secrets/smtp_password
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
SMTP_USE_TLS=true
ALERT_EMAIL=

# 카카오 — 키·토큰은 secrets/kakao_*
KAKAO_REDIRECT_URI=http://localhost:8088/kakao/callback

# 자동 알람 워처 (#121). 운영에서는 실제 발송을 켠다 — SLACK_WEBHOOK_URL 은 secrets.
ALERT_WATCH_SLACK_ENABLED=true
# ALERT_WATCH_COOLDOWN_MINUTES=60
# ALERT_WATCH_LAG_THRESHOLD=4
