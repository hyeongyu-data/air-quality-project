# 실제 값으로 채운 뒤 .env로 복사하세요. 발급 절차는 docs/RUNBOOK.md 참고.
#
# 이 파일은 세 블록으로 나뉩니다:
#   1. 설정 (비밀 아님)        — dev·운영 공통, .env
#   2. 비밀정보 — 개발          — 로컬 학습 편의로 .env에 직접 (docker inspect 노출 감수)
#   3. 비밀정보 — 운영          — .env에 넣지 말고 ./secrets/ 파일로 (secrets/README.md)
#                                 운영 프로필은 .env 대신 .env.prod를 쓴다(.env.prod.example)

# ─────────────────────────────────────────────────────────────
# 1. 설정 (비밀 아님)
# ─────────────────────────────────────────────────────────────

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX_PREFIX=weather-alert

# Consumer 상태 저장 경로. Compose에서는 명명 볼륨(/app/state)에 연결한다.
# 토큰과 쿨다운 캐시는 저장소에 커밋하지 않는다.
KAKAO_TOKEN_STATE_PATH=/app/state/kakao_token.json
SIGNATURE_STATE_PATH=/app/state/signature_state.json

# 알림 채널 (쓰는 것만 true)
EMAIL_ENABLED=false
KAKAO_ENABLED=false
SLACK_ENABLED=false

KAKAO_REDIRECT_URI=http://localhost:8088/kakao/callback

# 이메일 발신 설정 (비밀번호 제외)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_FROM_EMAIL=
# ALERT_EMAIL=

# 자동 알람 워처 (#121 — consumer/alert_watch.py, scripts/check_storage_health.sh)
# cron 설정은 docs/observability.md "자동 발송" 참고. SLACK_WEBHOOK_URL 재사용.
# ALERT_WATCH_SLACK_ENABLED=false        # true 여야 실제 Slack 발송 (아니면 dry-run 로그)
# ALERT_WATCH_LOOKBACK_MINUTES=70
# ALERT_WATCH_COOLDOWN_MINUTES=60
# ALERT_WATCH_LAG_THRESHOLD=4
# ALERT_WATCH_NO_HISTORY_HOURS=7
# DISK_USAGE_THRESHOLD=80

# ─────────────────────────────────────────────────────────────
# 2. 비밀정보 — 개발 (.env에 직접)
# ─────────────────────────────────────────────────────────────
# 운영에서는 아래를 .env에 넣지 말고 ./secrets/<이름> 파일로 분리한다.
# 코드는 <VAR>_FILE 환경변수가 있으면 그 파일을, 없으면 아래 값을 읽는다.

# 공공데이터 API
WEATHER_API_KEY=your_kma_service_key
AIRKOREA_API_KEY=your_airkorea_service_key

# 카카오 (KAKAO_ENABLED=true일 때 — scripts/kakao_get_refresh_token.py가 토큰을 채운다)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REFRESH_TOKEN=

# 이메일 앱 비밀번호 (EMAIL_ENABLED=true일 때)
# SMTP_PASSWORD=

# Slack Incoming Webhook (SLACK_ENABLED=true일 때, 그리고 알람 워처)
# SLACK_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────
# 3. 비밀정보 — 운영
# ─────────────────────────────────────────────────────────────
# ./secrets/ 파일로 분리한다. 목록·생성법은 secrets/README.md.
#   slack_webhook_url · smtp_password · kakao_rest_api_key · kakao_client_secret
#   kakao_refresh_token · opensearch_password · airflow_fernet_key · airflow_admin_password
#
# 운영 프로필(docker-compose.prod.yaml) 실행 시 compose 변수 보간용으로 .env에
# 아래도 필요하다 (Kafka UI는 _FILE 관례 미지원 — 127.0.0.1 전용):
# KAFKA_UI_PASSWORD=
